# AgentQuest Phase 2 — Server Configuration
# Copy this file to .env and insert your real Gemini API key

# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (Defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Backend Server Port (Defaults to 3001)
PORT=3001

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Local Ollama AI Model (Lightweight 0.6B model optimized for Mac M2 8GB)
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3:0.6b

